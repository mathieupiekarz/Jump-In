<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
  </head>

  <body class="bg-light">
    <div class="container mt-5">
      <h1 class="text-center mb-4"><%= title %></h1>

      <table class="table table-striped table-bordered shadow-sm">
        <thead class="table-dark">
          <tr>
            <th>Intitule</th>
            <th>Statut</th>
            <th>Responsable Hierarchique</th>
            <th>Type Métier</th>
            <th>Lieu Mission</th>
            <th>Rythme</th>
            <th>Fourchette Salaire</th>
            <th>Description</th>
            <th>Siren</th>
          </tr>
        </thead>
        <tbody>
          <% fiches.forEach((fiche) => { %> <% const parsed =
          JSON.parse(fiche.lieu_mission); %> <%var message =
          Object.values(parsed).join(' ') %>
          <tr>
            <td><%= fiche.intitule %></td>
            <td><%= fiche.statut_de_poste %></td>
            <td><%= fiche.responsable_hierarchique %></td>
            <td><%= fiche.type_metier %></td>
            <td><%= message %></td>
            <td><%= fiche.rythme %></td>
            <td><%= fiche.fourchette_salaire %></td>
            <td><%= fiche.description %></td>
            <td><%= fiche.siren %></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
