<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mes candidatures - Jump'In</title>

    <link rel="stylesheet" href="/stylesheets/style.css" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css"
    />

    <style>
      @media screen and (max-width: 730px) {
        .sidebar {
          display: none;
          width: 280px;
          background: white;
          padding: 20px;
          border-radius: 10px;
          box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);
        }

        .search-bar {
          display: block;
          max-width: 100%;
          margin-bottom: 20px;
        }

        .job-header h2 {
          font-size: 15px;
        }
      }
    </style>
  </head>

  <body>
    <header class="header">
      <div>
        <img src="/images/JumpIn_Logo.png" alt="Jump'In Logo" height="80" />
      </div>
      <nav>
        <ul class="nav-links">
          <a href="/users/login" class="active" style="color: indianred"
            >Déconnexion</a
          >
          <li><a href="./ListeOffres">Les offres</a></li>
          <li><a href="./MesOffres" class="active">Mes candidatures</a></li>
          <li><a href="./profile" class="btn-connexion">Mon Profil</a></li>
        </ul>

        <div class="burger" onclick="toggleMenu()">
          <div></div>
          <div></div>
          <div></div>
        </div>
      </nav>
    </header>

    <script>
      function toggleMenu() {
        document.querySelector(".nav-links").classList.toggle("active");
      }
    </script>

    <div class="container">
      <main class="job-list">
        <div class="search-bar">
          <input
            type="text"
            placeholder="Rechercher parmi mes candidatures..."
          />
          <button class="filter-btn">Filtrer</button>
          <button class="search-btn">Rechercher</button>
        </div>

        <% if (offres.length === 0) { %>
        <div class="no-candidatures">
          <h3>Vous n'avez pas encore de candidature</h3>
          <p>
            Explorez nos offres d'emploi et postulez aux postes qui
            correspondent à votre profil.
          </p>
          <a href="./ListeOffres" class="btn">Voir les offres</a>
        </div>
        <% } else { %> <% offres.forEach((offre) => { %>
        <div class="job">
          <div class="job-header2">
            <div class="job-header2">
              <img
                src="/images/<%= offre.organisation_nom.toLowerCase() %>-logo.png"
                alt="<%= offre.organisation_nom %>"
              />
              <div>
                <h2><%= offre.intitule %></h2>
                <p><%= offre.organisation_nom %></p>
              </div>
            </div>
            <a href="/users/offre2/<%= offre.numero %>">
              <i
                class="bi bi-eye-fill"
                style="color: #333; font-size: 30px"
              ></i>
            </a>
          </div>
          <div class="job-context">
            <p><%= offre.description %></p>
          </div>

          <div class="job-footer">
            <span class="candidature-date">
              Candidature du <%= new
              Date(offre.date_candidature).toLocaleDateString() %>
            </span>
          </div>
        </div>
        <% }) %> <% } %>
      </main>
    </div>
  </body>

  <script>
    function toggleMenu() {
      document.querySelector(".nav-links").classList.toggle("active");
    }
  </script>
</html>
