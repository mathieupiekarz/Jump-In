<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Jump'In</title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
</head>

<body>
    <header class="header">
        <div>
            <img src="/images/JumpIn_Logo.png" alt="Jump'In Logo" height="80">
        </div>
        <nav>
            <ul class="nav-links">
                <li><a href="#">Tableau de bord</a></li>
                <li><a href="/recruteur/<%= organisation.siren %>/NosOffres">Nos offres</a></li>
                <li><a href="/recruteur/mon-compte" class="btn-connexion">Mon Compte</a></li>
            </ul>

            <div class="burger" onclick="toggleMenu()">
                <div></div>
                <div></div>
                <div></div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main class="job-list">
            <!-- En-tête du profil -->
            <div class="org-banner">
                <img src="/images/<%= organisation.nom.toLowerCase() %>-logo.png" alt="<%= organisation.nom %>" class="org-logo" onerror="this.src='/images/default-logo.png'">
                <div class="org-info">
                    <h2><%= organisation.nom %></h2>
                    <p>SIREN: <%= organisation.siren %> • Type: <%= organisation.type %></p>
                </div>
            </div>

            <!-- Informations personnelles -->
            <div class="demande1">
                <h3>Informations personnelles</h3>
                <div class="demande2">
                    <div class="fiche-details" style="width: 100%;">
                        <div class="fiche-detail-item">
                            <strong>Nom</strong>
                            <%= recruteur.nom %>
                        </div>
                        <div class="fiche-detail-item">
                            <strong>Prénom</strong>
                            <%= recruteur.prenom %>
                        </div>
                        <div class="fiche-detail-item">
                            <strong>Email</strong>
                            <%= recruteur.email %>
                        </div>
                        <div class="fiche-detail-item">
                            <strong>Téléphone</strong>
                            <%= recruteur.numero_telephone %>
                        </div>
                        <div class="fiche-detail-item">
                            <strong>Statut</strong>
                            <span class="status-badge <%= recruteur.statut === 'actif' ? 'status-active' : 'status-inactive' %>">
                                <%= recruteur.statut %>
                            </span>
                        </div>
                        <div class="fiche-detail-item">
                            <strong>Date de création</strong>
                            <%= new Date(recruteur.date_creation).toLocaleDateString() %>
                        </div>
                    </div>
                </div>
                <div class="actions-buttons" style="margin-top: 20px; justify-content: center;">
                    <button class="action-btn edit-btn" onclick="openEditProfileModal()">
                        <i class="bi bi-pencil-fill"></i> Modifier mon profil
                    </button>
                    <button class="action-btn warning" onclick="openChangePasswordModal()">
                        <i class="bi bi-key-fill"></i> Changer mon mot de passe
                    </button>
                    <button class="action-btn danger" onclick="openChangeOrganizationModal()">
                        <i class="bi bi-building-fill"></i> Changer d'organisation
                    </button>
                </div>
            </div>
        </main>
    </div>

    <!-- Modal de changement d'organisation -->
    <div id="changeOrganizationModal" class="modal-overlay">
        <div class="modal-content">
            <button class="close-btn" onclick="closeModal('changeOrganizationModal')">&times;</button>
            <h3>Changer d'organisation</h3>
            <form id="changeOrganizationForm" action="/recruteur/changer-organisation" method="POST">
                <div class="form-group">
                    <label for="nouveau_siren">Nouvelle organisation *</label>
                    <select id="nouveau_siren" name="nouveau_siren" required>
                        <option value="">Sélectionner une organisation</option>
                        <% organisations.forEach(function(org) { %>
                            <option value="<%= org.siren %>"><%= org.nom %> (SIREN: <%= org.siren %>)</option>
                        <% }); %>
                    </select>
                </div>
                
                <div class="form-group">
                    <label for="description">Raison du changement *</label>
                    <textarea id="description" name="description" required 
                        placeholder="Veuillez expliquer la raison de votre demande de changement d'organisation..."></textarea>
                </div>
                
                <div class="form-buttons">
                    <button type="button" class="btn2" onclick="closeModal('changeOrganizationModal')">Annuler</button>
                    <button type="submit" class="btn">Envoyer la demande</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function toggleMenu() {
            document.querySelector(".nav-links").classList.toggle("active");
        }

        function openEditProfileModal() {
            // À implémenter
            alert("Fonctionnalité à venir");
        }

        function openChangePasswordModal() {
            // À implémenter
            alert("Fonctionnalité à venir");
        }

        function openChangeOrganizationModal() {
            document.getElementById('changeOrganizationModal').style.display = 'flex';
        }

        function closeModal(modalId) {
            document.getElementById(modalId).style.display = 'none';
        }

        // Fermer les modals quand on clique en dehors
        window.onclick = function(event) {
            const modals = document.querySelectorAll('.modal-overlay');
            modals.forEach(modal => {
                if (event.target === modal) {
                    modal.style.display = 'none';
                }
            });
        }
    </script>
</body>

</html> 