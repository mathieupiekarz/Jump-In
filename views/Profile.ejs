<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mon Profil</title>

    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">


    <style>

        @media screen and (max-width: 730px) {

        .search-bar {
            display: block;
            max-width: 100%;
            margin-bottom: 20px;
        }

        .job-header2 h2 {
            font-size: 15px;
        }
        
        }
    </style>

</head>
<body>
    <header class="header">
        <div>
            <img src="/images/JumpIn_Logo.png" alt="Jump'In Logo" height="80">
        </div>
        <nav>
            <ul class="nav-links">
                <li><a href="#">Home</a></li>
                <li><a href="./ListeOffres">Les offres</a></li>
                <li><a href="./MesOffres">Mes candidatures</a></li>
                <li><a href="./Profile" class="btn-connexion">Mon Profil</a></li>
            </ul>

            <div class="burger" onclick="toggleMenu()">
                <div></div>
                <div></div>
                <div></div>
            </div>
        </nav>
    </header>

    <script>
        function toggleMenu() {
            document.querySelector(".nav-links").classList.toggle("active");
        }
    </script>

    <% if (typeof successMessage !== 'undefined' && successMessage) { %>
    <div id="successNotification" class="success-notification">
        <%= successMessage %>
    </div>
    <script>
        // Faire disparaître la notification après 3 secondes
        setTimeout(function() {
            const notification = document.getElementById('successNotification');
            notification.classList.add('fadeOut');
            setTimeout(function() {
                notification.style.display = 'none';
            }, 500);
        }, 3000);
    </script>
    <% } %>

    <div class="container">

        <div class="job-list">
            <div class="search-bar">
                <input type="text" placeholder="Le job de vos rêves..." />
                <button class="filter-btn">Filtrer</button>
                <button class="search-btn">Rechercher</button>
            </div>

            <div class="job">
                <div class="job-header2">
                    <div class="job-header2">
                        <img src="/images/profile-logo.png" alt="Profile Logo" />
                        <div>
                            <h2><%= candidat.prenom %> <%= candidat.nom %></h2>
                            <p>Candidat</p>
                        </div>
                    </div>
                    <span>
                    <a href="#"><i class="bi bi-pencil" style="color: #333;"></i></a>
                    <button class="btn2" id="joinBtn">Rejoindre</button>
                    <button class="btn" id="modifyBtn">Modifier</button>
                    </span>
                </div>
            </div>
            <div class="job">
                <div>
                    <div class="job-content">
                        <h4>Informations du profil :</h4>
                        <div class="caracteristiques">
                            <p class="smallbox"><strong>Prénom :</strong> <%= candidat.prenom %> </p>
                            <p class="smallbox"><strong>Nom :</strong> <%= candidat.nom %> </p>
                            <p class="smallbox"><strong>E-mail :</strong> <%= candidat.email %> </p>
                            <p class="smallbox"><strong>Téléphone :</strong> <%= candidat.numero_telephone %> </p>
                            <p class="smallbox"><strong>Statut :</strong> <%= candidat.statut %> </p>
                                                
                        </div>
                    </div>
                    <div class="job-content">
                        <h4>Détails du profil :</h4>
                        <p>Étudiant en 3ème année à l'UTC en Génie Informatique, je souhaite me spécialiser en Intelligence et Sciences des Données. Je recherche un stage de 6 mois à partir de Septembre 2025 en Data, IA ou développement informatique.</p>
                    </div>
                    <div class="job-content">
                        <h4>Mes documents :</h4>
                        <span class="caracteristiques">
                            <input type="file" placeholder="Mon CV..."></span>
                            <input type="file" placeholder="Ma Lettre de Motivation..."></span>
                            <input type="file" placeholder="Mon diplôme..."></span>
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal de modification du profil -->
    <div id="editProfileModal" class="modal-profile">
        <div class="modal-content-profile">
            <div class="modal-header-profile">
                <h3>Modifier mon profil</h3>
                <span class="close-profile" id="closeModal">&times;</span>
            </div>
            <form id="editProfileForm" action="/users/updateProfile" method="POST">
                <div class="form-group-profile">
                    <label for="prenom">Prénom</label>
                    <input type="text" id="prenom" name="prenom" value="<%= candidat.prenom %>" required>
                </div>
                <div class="form-group-profile">
                    <label for="nom">Nom</label>
                    <input type="text" id="nom" name="nom" value="<%= candidat.nom %>" required>
                </div>
                <div class="form-group-profile">
                    <label for="email">E-mail</label>
                    <input type="email" id="email" name="email" value="<%= candidat.email %>" required>
                </div>
                <div class="form-group-profile ">
                    <label for="numero_telephone">Téléphone (format: +33XXXXXXXXX)</label>
                    <input type="tel" id="numero_telephone" name="numero_telephone" value="<%= candidat.numero_telephone %>" pattern="^\+33\d{9}$" required>
                </div>
                <div class="form-group-profile">
                    <label for="mdp">Nouveau mot de passe (laisser vide pour ne pas changer)</label>
                    <input type="password" id="mdp" name="mdp" placeholder="Nouveau mot de passe">
                    <small>Le mot de passe doit contenir au moins 12 caractères, 2 majuscules, 2 minuscules et 2 caractères spéciaux</small>
                </div>
                <div class="form-group-profile">
                    <label for="mdp_confirm">Confirmer le mot de passe</label>
                    <input type="password" id="mdp_confirm" name="mdp_confirm" placeholder="Confirmer le mot de passe">
                </div>
                <input type="hidden" name="id_can" value="<%= candidat.id_can %>">
                <div class="form-buttons-profile">
                    <button type="button" class="cancel-btn-profile" id="cancelBtn">Annuler</button>
                    <button type="submit" class="save-btn-profile">Enregistrer</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal de demande de recrutement -->
    <div id="joinModal" class="modal-profile">
        <div class="modal-content-profile">
            <div class="modal-header-profile">
                <h3>Demande de recrutement</h3>
                <span class="close-profile" id="closeJoinModal">&times;</span>
            </div>
            <form id="joinForm" action="/users/demande-recruteur" method="POST">
                <div class="form-group">
                    <label for="siren">Organisation</label>
                    <select id="siren" name="siren" required>
                        <option value="">Sélectionner une organisation</option>
                        <% organisations.forEach(function(org) { %>
                            <option value="<%= org.siren %>"><%= org.nom %> (SIREN: <%= org.siren %>)</option>
                        <% }); %>
                    </select>
                    <small>Sélectionnez l'organisation que vous souhaitez rejoindre</small>
                </div>
                <div class="form-group">
                    <label for="description">Description de votre demande</label>
                    <input type="text" id="description" name="description" required minlength="10" placeholder="Expliquez pourquoi vous souhaitez rejoindre cette organisation">
                    <small>Minimum 10 caractères</small>
                </div>
                <div class="form-buttons-profile">
                    <button type="button" class="cancel-btn-profile" id="cancelJoinBtn">Annuler</button>
                    <button type="submit" class="save-btn-profile">Envoyer la demande</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        // Gestion du modal de modification
        const modal = document.getElementById("editProfileModal");
        const modifyBtn = document.getElementById("modifyBtn");
        const closeModal = document.getElementById("closeModal");
        const cancelBtn = document.getElementById("cancelBtn");
        const form = document.getElementById("editProfileForm");
        const mdpInput = document.getElementById("mdp");
        const mdpConfirmInput = document.getElementById("mdp_confirm");

        // Gestion du modal de demande de recrutement
        const joinModal = document.getElementById("joinModal");
        const joinBtn = document.getElementById("joinBtn");
        const closeJoinModal = document.getElementById("closeJoinModal");
        const cancelJoinBtn = document.getElementById("cancelJoinBtn");
        const joinForm = document.getElementById("joinForm");

        // Ouvrir le modal
        modifyBtn.onclick = function() {
            modal.style.display = "block";
        }

        // Fermer le modal
        closeModal.onclick = function() {
            modal.style.display = "none";
        }

        cancelBtn.onclick = function() {
            modal.style.display = "none";
        }

        // Ouvrir le modal de demande de recrutement
        joinBtn.onclick = function() {
            joinModal.style.display = "block";
        }

        // Fermer le modal de demande de recrutement
        closeJoinModal.onclick = function() {
            joinModal.style.display = "none";
        }

        cancelJoinBtn.onclick = function() {
            joinModal.style.display = "none";
        }

        // Fermer si on clique en dehors du modal
        window.onclick = function(event) {
            if (event.target == modal) {
                modal.style.display = "none";
            }
            if (event.target == joinModal) {
                joinModal.style.display = "none";
            }
        }

        // Validation du formulaire de demande de recrutement
        joinForm.onsubmit = function(e) {
            const siren = document.getElementById("siren").value;
            const description = document.getElementById("description").value;

            if (!/^[0-9]{9}$/.test(siren)) {
                e.preventDefault();
                alert("Le SIREN doit contenir exactement 9 chiffres.");
                return false;
            }

            if (description.length < 10) {
                e.preventDefault();
                alert("La description doit contenir au moins 10 caractères.");
                return false;
            }

            return true;
        }

        // Validation du formulaire de modification
        form.onsubmit = function(e) {
            // Vérifier que les mots de passe correspondent
            if (mdpInput.value && mdpInput.value !== mdpConfirmInput.value) {
                e.preventDefault();
                alert("Les mots de passe ne correspondent pas.");
                return false;
            }
            
            // Vérifier le format du mot de passe si renseigné
            if (mdpInput.value) {
                const regex = /^(?=(?:.*[A-ZÀÂÄÇÉÈÊËÎÏÔÖÛÜÙ]){2,})(?=(?:.*[a-zàâäçéèêëîïôöûüùÿ]){2,})(?=(?:.*[!?@\$%&\*\+=\-_.,;:\/\\\|\^~#\(\)\[\]\{\}<>`'"€£µ§°¤]){2,})[A-ZÀÂÄÇÉÈÊËÎÏÔÖÛÜÙa-zàâäçéèêëîïôöûüùÿ!?@\$%&\*\+=\-_.,;:\/\\|^~#()\[\]{}<>'"`€£µ§°¤]{12,}$/;
                if (!regex.test(mdpInput.value)) {
                    e.preventDefault();
                    alert("Le mot de passe ne respecte pas les critères de sécurité.");
                    return false;
                }
            }
            
            return true;
        }
    </script>
</body>
</html>