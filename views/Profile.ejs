<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mon Profil</title>

    <link rel="stylesheet" href="/stylesheets/style.css" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css"
    />

    <style>
      @media screen and (max-width: 730px) {
        .search-bar {
          display: block;
          max-width: 100%;
          margin-bottom: 20px;
        }

        .job-header2 h2 {
          font-size: 15px;
        }
      }
    </style>
  </head>
  <body>
    <header class="header">
      <div>
        <img src="/images/JumpIn_Logo.png" alt="Jump'In Logo" height="80" />
      </div>
      <nav>
        <ul class="nav-links">
          <li><a href="/users/login" class="active">Connexion</a></li>
          <li><a href="./ListeOffres">Les offres</a></li>
          <li><a href="./MesOffres">Mes candidatures</a></li>
          <li><a href="./Profile" class="btn-connexion">Mon Profil</a></li>
        </ul>

        <div class="burger" onclick="toggleMenu()">
          <div></div>
          <div></div>
          <div></div>
        </div>
      </nav>
    </header>

    <script>
      function toggleMenu() {
        document.querySelector(".nav-links").classList.toggle("active");
      }
    </script>

    <% if (typeof successMessage !== 'undefined' && successMessage) { %>
    <div id="successNotification" class="success-notification">
      <%= successMessage %>
    </div>
    <script>
      // Faire disparaître la notification après 3 secondes
      setTimeout(function () {
        const notification = document.getElementById("successNotification");
        notification.classList.add("fadeOut");
        setTimeout(function () {
          notification.style.display = "none";
        }, 500);
      }, 3000);
    </script>
    <% } %>

    <div class="container">
      <div class="job-list">
        <div class="job">
          <div class="job-header2">
            <div class="job-header2">
              <img src="/images/profile-logo.png" alt="Profile Logo" />
              <div>
                <h2><%= candidat.prenom %> <%= candidat.nom %></h2>
                <p>Candidat</p>
              </div>
            </div>
            <span>
              <a href="#"
                ><i
                  class="bi bi-plus-circle"
                  style="color: #333"
                  id="createOrgBtn"
                ></i
              ></a>
              <button class="btn2" id="joinBtn">Rejoindre</button>
              <button class="btn" id="modifyBtn">Modifier</button>
            </span>
          </div>
        </div>
        <div class="job">
          <div>
            <div class="job-content">
              <h4>Informations du profil :</h4>
              <div class="caracteristiques">
                <p class="smallbox">
                  <strong>Prénom :</strong> <%= candidat.prenom %>
                </p>
                <p class="smallbox">
                  <strong>Nom :</strong> <%= candidat.nom %>
                </p>
                <p class="smallbox">
                  <strong>E-mail :</strong> <%= candidat.email %>
                </p>
                <p class="smallbox">
                  <strong>Téléphone :</strong> <%= candidat.numero_telephone %>
                </p>
                <p class="smallbox">
                  <strong>Statut :</strong> <%= candidat.statut %>
                </p>
              </div>
            </div>
            <div class="job-content">
              <h4>Charger une pièce-jointe :</h4>
              <div class="upload-container">
                <div id="dropZone">
                  <p>
                    Déposez un fichier ici ou
                    <strong>cliquez pour en choisir un</strong>
                  </p>
                  <input type="file" id="fileInput" name="file" />
                </div>

                <div class="nom-fichier">
                  <label>Nom du fichier (affiché) :</label>
                  <input
                    type="text"
                    id="nomFichierInput"
                    placeholder="ex: Mon CV 2025"
                  />
                </div>
              </div>
              <button class="btn" id="envoyerBtn" disabled>
                Envoyer le fichier
              </button>
              <div
                id="messageZone"
                style="margin-top: 10px; color: green"
              ></div>
              <!-- zone d'ajout des documents -->
              <h4>Mes documents :</h4>
              <div id="fileList"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Modal de modification du profil -->
    <div id="editProfileModal" class="modal-profile">
      <div class="modal-content-profile">
        <div class="modal-header-profile">
          <h3>Modifier mon profil</h3>
          <span class="close-profile" id="closeModal">&times;</span>
        </div>
        <form id="editProfileForm" action="/users/updateProfile" method="POST">
          <div class="form-group-profile">
            <label for="prenom">Prénom</label>
            <input
              type="text"
              id="prenom"
              name="prenom"
              value="<%= candidat.prenom %>"
              required
            />
          </div>
          <div class="form-group-profile">
            <label for="nom">Nom</label>
            <input
              type="text"
              id="nom"
              name="nom"
              value="<%= candidat.nom %>"
              required
            />
          </div>
          <div class="form-group-profile">
            <label for="email">E-mail</label>
            <input
              type="email"
              id="email"
              name="email"
              value="<%= candidat.email %>"
              required
            />
          </div>
          <div class="form-group-profile">
            <label for="numero_telephone"
              >Téléphone (format: +33XXXXXXXXX)</label
            >
            <input
              type="tel"
              id="numero_telephone"
              name="numero_telephone"
              value="<%= candidat.numero_telephone %>"
              pattern="^\+33\d{9}$"
              required
            />
          </div>
          <div class="form-group-profile">
            <label for="mdp"
              >Nouveau mot de passe (laisser vide pour ne pas changer)</label
            >
            <input
              type="password"
              id="mdp"
              name="mdp"
              placeholder="Nouveau mot de passe"
            />
            <small
              >Le mot de passe doit contenir au moins 12 caractères, 2
              majuscules, 2 minuscules et 2 caractères spéciaux</small
            >
          </div>
          <div class="form-group-profile">
            <label for="mdp_confirm">Confirmer le mot de passe</label>
            <input
              type="password"
              id="mdp_confirm"
              name="mdp_confirm"
              placeholder="Confirmer le mot de passe"
            />
          </div>
          <input type="hidden" name="id_can" value="<%= candidat.id_can %>" />
          <div class="form-buttons-profile">
            <button type="button" class="cancel-btn-profile" id="cancelBtn">
              Annuler
            </button>
            <button type="submit" class="save-btn-profile">Enregistrer</button>
          </div>
        </form>
      </div>
    </div>

    <!-- Modal de demande de recrutement -->
    <div id="joinModal" class="modal-profile">
      <div class="modal-content-profile">
        <div class="modal-header-profile">
          <h3>Demande de recrutement</h3>
          <span class="close-profile" id="closeJoinModal">&times;</span>
        </div>
        <form id="joinForm" action="/users/demande-recruteur" method="POST">
          <div class="form-group">
            <label for="siren_join">Organisation</label>
            <select id="siren_join" name="siren" required>
              <option value="">Sélectionner une organisation</option>
              <% organisations.forEach(function(org) { %>
              <option value="<%= org.siren %>">
                <%= org.nom %> (SIREN: <%= org.siren %>)
              </option>
              <% }); %>
            </select>
            <small
              >Sélectionnez l'organisation que vous souhaitez rejoindre</small
            >
          </div>
          <div class="form-group">
            <label for="description">Description de votre demande</label>
            <input
              type="text"
              id="description"
              name="description"
              required
              minlength="10"
              placeholder="Expliquez pourquoi vous souhaitez rejoindre cette organisation"
            />
            <small>Minimum 10 caractères</small>
          </div>
          <div class="form-buttons-profile">
            <button type="button" class="cancel-btn-profile" id="cancelJoinBtn">
              Annuler
            </button>
            <button type="submit" class="save-btn-profile">
              Envoyer la demande
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Modal de création d'organisation -->
    <div id="createOrgModal" class="modal-profile">
      <div class="modal-content-profile">
        <div class="modal-header-profile">
          <h3>Créer une organisation</h3>
          <span class="close-profile" id="closeCreateOrgModal">&times;</span>
        </div>
        <form
          id="createOrgForm"
          action="/users/demande-creation-organisation"
          method="POST"
        >
          <div class="form-group">
            <label for="siren_create">SIREN de l'organisation</label>
            <input
              type="text"
              id="siren_create"
              name="siren"
              required
              pattern="[0-9]{9}"
              maxlength="9"
              placeholder="Entrez le SIREN (9 chiffres)"
            />
            <small>Le SIREN doit contenir exactement 9 chiffres</small>
          </div>
          <div class="form-group">
            <label for="nom">Nom de l'organisation</label>
            <input
              type="text"
              id="nom"
              name="nom"
              required
              placeholder="Entrez le nom de l'organisation"
            />
          </div>
          <div class="form-group">
            <label for="type">Type d'organisation</label>
            <select id="type" name="type" required>
              <option value="">Sélectionnez un type</option>
              <option value="association">Association</option>
              <option value="EURL">EURL</option>
              <option value="SA">SA</option>
              <option value="SAS">SAS</option>
              <option value="SASU">SASU</option>
              <option value="ONG">ONG</option>
              <option value="SARL">SARL</option>
              <option value="SNC">SNC</option>
              <option value="SCS">SCS</option>
              <option value="SCA">SCA</option>
              <option value="SCI">SCI</option>
              <option value="SCP">SCP</option>
              <option value="SCM">SCM</option>
              <option value="SCEA">SCEA</option>
              <option value="SCCV">SCCV</option>
              <option value="SCPa">SCPa</option>
              <option value="EARL">EARL</option>
              <option value="GAEC">GAEC</option>
              <option value="SCIC">SCIC</option>
              <option value="SCOP">SCOP</option>
              <option value="GIE">GIE</option>
              <option value="GEIE">GEIE</option>
              <option value="GE">GE</option>
            </select>
          </div>
          <div class="form-group">
            <label>Siège social</label>
            <div class="form-group">
              <input
                type="text"
                name="siege_nom"
                required
                placeholder="Nom du siège social"
              />
            </div>
            <div class="form-group">
              <input
                type="text"
                name="siege_adresse"
                required
                placeholder="Adresse"
              />
            </div>
            <div class="form-group">
              <input
                type="text"
                name="siege_complement"
                placeholder="Complément d'adresse"
              />
            </div>
            <div class="form-group">
              <input
                type="text"
                name="siege_code_postal"
                required
                placeholder="Code postal"
              />
            </div>
            <div class="form-group">
              <input
                type="text"
                name="siege_ville"
                required
                placeholder="Ville"
              />
            </div>
            <div class="form-group">
              <input
                type="text"
                name="siege_pays"
                required
                placeholder="Pays"
              />
            </div>
          </div>
          <div class="form-group">
            <label for="description_create">Description de votre demande</label>
            <textarea
              id="description_create"
              name="description"
              required
              minlength="10"
              placeholder="Expliquez pourquoi vous souhaitez créer cette organisation"
              rows="4"
            ></textarea>
            <small>Minimum 10 caractères</small>
          </div>
          <div class="form-buttons-profile">
            <button
              type="button"
              class="cancel-btn-profile"
              id="cancelCreateOrgBtn"
            >
              Annuler
            </button>
            <button type="submit" class="save-btn-profile">
              Envoyer la demande
            </button>
          </div>
        </form>
      </div>
    </div>

    <script>
      // Gestion du modal de modification
      const modal = document.getElementById("editProfileModal");
      const modifyBtn = document.getElementById("modifyBtn");
      const closeModal = document.getElementById("closeModal");
      const cancelBtn = document.getElementById("cancelBtn");
      const form = document.getElementById("editProfileForm");
      const mdpInput = document.getElementById("mdp");
      const mdpConfirmInput = document.getElementById("mdp_confirm");

      // Gestion du modal de demande de recrutement
      const joinModal = document.getElementById("joinModal");
      const joinBtn = document.getElementById("joinBtn");
      const closeJoinModal = document.getElementById("closeJoinModal");
      const cancelJoinBtn = document.getElementById("cancelJoinBtn");
      const joinForm = document.getElementById("joinForm");

      // Gestion du modal de création d'organisation
      const createOrgModal = document.getElementById("createOrgModal");
      const createOrgBtn = document.getElementById("createOrgBtn");
      const closeCreateOrgModal = document.getElementById(
        "closeCreateOrgModal"
      );
      const cancelCreateOrgBtn = document.getElementById("cancelCreateOrgBtn");
      const createOrgForm = document.getElementById("createOrgForm");

      // Ouvrir le modal
      modifyBtn.onclick = function () {
        modal.style.display = "block";
      };

      // Fermer le modal
      closeModal.onclick = function () {
        modal.style.display = "none";
      };

      cancelBtn.onclick = function () {
        modal.style.display = "none";
      };

      // Ouvrir le modal de demande de recrutement
      joinBtn.onclick = function () {
        joinModal.style.display = "block";
      };

      // Fermer le modal de demande de recrutement
      closeJoinModal.onclick = function () {
        joinModal.style.display = "none";
      };

      cancelJoinBtn.onclick = function () {
        joinModal.style.display = "none";
      };

      // Ouvrir le modal de création d'organisation
      createOrgBtn.onclick = function () {
        createOrgModal.style.display = "block";
      };

      // Fermer le modal de création d'organisation
      closeCreateOrgModal.onclick = function () {
        createOrgModal.style.display = "none";
      };

      cancelCreateOrgBtn.onclick = function () {
        createOrgModal.style.display = "none";
      };

      // Fermer si on clique en dehors du modal
      window.onclick = function (event) {
        if (event.target == modal) {
          modal.style.display = "none";
        }
        if (event.target == joinModal) {
          joinModal.style.display = "none";
        }
        if (event.target == createOrgModal) {
          createOrgModal.style.display = "none";
        }
      };

      // Validation du formulaire de demande de recrutement
      joinForm.onsubmit = function (e) {
        const siren = document.getElementById("siren_join").value;
        const description = document.getElementById("description").value;

        if (!/^[0-9]{9}$/.test(siren)) {
          e.preventDefault();
          alert("Le SIREN doit contenir exactement 9 chiffres.");
          return false;
        }

        if (description.length < 10) {
          e.preventDefault();
          alert("La description doit contenir au moins 10 caractères.");
          return false;
        }

        return true;
      };

      // Validation du formulaire de modification
      form.onsubmit = function (e) {
        // Vérifier que les mots de passe correspondent
        if (mdpInput.value && mdpInput.value !== mdpConfirmInput.value) {
          e.preventDefault();
          alert("Les mots de passe ne correspondent pas.");
          return false;
        }

        return true;
      };

      // Validation du formulaire de création d'organisation
      createOrgForm.onsubmit = function (e) {
        const siren = document.getElementById("siren_create").value;
        const description = document.getElementById("description_create").value;

        if (!/^[0-9]{9}$/.test(siren)) {
          e.preventDefault();
          alert("Le SIREN doit contenir exactement 9 chiffres.");
          return false;
        }

        if (description.length < 10) {
          e.preventDefault();
          alert("La description doit contenir au moins 10 caractères.");
          return false;
        }

        return true;
      };

      // gestion des pièces jointes
      const envoyerBtn = document.getElementById("envoyerBtn");
      const fileInput = document.getElementById("fileInput");
      const nomFichierInput = document.getElementById("nomFichierInput");
      const messageZone = document.getElementById("messageZone");
      const fileList = document.getElementById("fileList");
      const dropZone = document.getElementById("dropZone");

      // affichage des pièces jointes déjà chargée
      window.addEventListener("DOMContentLoaded", loadPiecesJointes);

      async function loadPiecesJointes() {
        const response = await fetch("/users/pieces-jointes");
        const pieces = await response.json();

        fileList.innerHTML = "";

        const p = document.createElement("p");
        if (pieces.length === 0) {
          p.textContent = "Aucune pièce jointe associée.";
          fileList.appendChild(p);
        } else {
          pieces.forEach((pj) => {
            const p = document.createElement("p");
            p.innerHTML = `<i class="bi bi-file-earmark-check-fill" style="color: #007bff; margin-right: 5px;"></i> ${pj.nom}`;
            fileList.appendChild(p);
          });
        }
      }

      // Clique sur la zone déclenche l'ouverture de l'explorateur
      dropZone.addEventListener("click", () => {
        fileInput.click();
      });

      // Empêcher le comportement par défaut du navigateur (ouvrir le fichier dans l’onglet)
      dropZone.addEventListener("dragover", (e) => {
        e.preventDefault();
        dropZone.style.backgroundColor = "#eef";
      });

      dropZone.addEventListener("dragleave", () => {
        dropZone.style.backgroundColor = ""; // reset du style
      });

      // Gestion du drop
      dropZone.addEventListener("drop", (e) => {
        e.preventDefault();
        dropZone.style.backgroundColor = "";

        if (e.dataTransfer.files.length > 0) {
          fileInput.files = e.dataTransfer.files;

          // Déclencher l'événement change à la main
          const event = new Event("change");
          fileInput.dispatchEvent(event);
        }
      });

      let fichierCharge = null;
      // Détection fichier sélectionné
      fileInput.addEventListener("change", () => {
        if (fileInput.files.length > 0) {
          fichierCharge = fileInput.files[0];
          messageZone.innerHTML = `Fichier Chargé correctement : ${fichierCharge.name} <br>Entrez un nom puis cliquez sur Envoyer<br />`;
          envoyerBtn.disabled = false;
        } else {
          fichierCharge = null;
          messageZone.textContent = "Aucun fichier selectionné.";
          envoyerBtn.disabled = true;
        }
      });

      // Envoi au clic
      envoyerBtn.addEventListener("click", async () => {
        const nomPersonnalise = nomFichierInput.value.trim();
        if (!fichierCharge || !nomPersonnalise) {
          alert("Veuillez selectionner un fichier et donner un nom.");
          return;
        }

        const formData = new FormData();
        const ext = fichierCharge.name.split(".").pop();
        const nomPerso = nomFichierInput.value
          .trim()
          .replace(/\s+/g, "_")
          .replace(/[^\w\-]/g, "");
        const nomfinal = `${nomPerso}.${ext}`;

        formData.append("file", fichierCharge, nomfinal);

        const response = await fetch("/users/upload", {
          method: "POST",
          body: formData,
        });

        const result = await response.json();

        if (response.ok) {
          messageZone.innerHTML = `<i class="bi bi-check-circle-fill" style="color: green;"></i> Fichier "${nomPersonnalise}" envoyé avec succès !`;
          envoyerBtn.disabled = true;
          fichierCharge = null;
          fileInput.value = "";
          nomFichierInput.value = "";
        } else {
          console.log(result.code);
          if (result.code === "EXTENSION_NON_AUTORISEE") {
            alert(result.message);
          } else if (result.code === "LIMIT_FILE_SIZE") {
            alert(result.message);
          } else if (result.code === "UPLOAD_ERROR") {
            alert(result.message);
          } else {
            alert(result.message || "Erreur lors de l'envoie du fichier.");
          }
        }
      });
    </script>
  </body>
</html>
