@startuml
class Utilisateur{
    email : str
    mdp : str
    nom : str
    prenom : str
    numero_telephone : int
    date_creation : date 
    statut : enum {actif, inactif}
    CreerCompte()
    Autentifier(email:str, mdp:str)
    TelechargerFichiers()
}

class Candidat{
    RechercherOffre()
    ConsulterOffre()
    ConsulterProfil()
    ModifierProfil()
}

class Recruteur{
    ModifierProfil()
    PublierOffre()
    SupprimerOffre()
    ModifierOffre()
    ConsulterDemande()
}

class Administrateur{
    DonnerDroitsAdmin()
    ConsulterOrganisation()
    ValiderOrganisation()
    ConsulterRecruteur()
    ValiderRecruteur()
}

class Organisation{
    numero_SIREN : int {key}
    nom : str
    type : enum {association, Eurl, Sarl, SASU, ...}
    siege_social : adresse
    statut : enum {innactive, en cours, active}
}

class Offre_Emploi{
    numero : int {key}
    etat : {non_publiee, publiee, expiree}
    date_validite : date
    indication : str
    nb_pieces_demandees : int
}

class Fiche_Poste{
    intitule : str
    statut_de_poste : enum  {cadre, ETAM, ...}
    responsable_hierarchique : str
    type_metier : str
    lieu_mission : adresse
    rythme : str
    fourchette_salaire : str
    description : str
}

class Candidature{
    date_candidature : date
}

class Piece_Jointe_Durable{
    chemin : string {key}
    nom : str
    type : enum {pdf, jpeg, png, xlsx, docx, ...}
}

class Piece_Jointe_Temporaire{
    chemin : string {key}
    nom : str
    type : enum {pdf, jpeg, png, xlsx, docx, ...}
}

class DemandeRecruteur{
    descriptionDR : str
    dateDemandeDR : date
    statutDR : enum {validee, refusee, en_attente}
}
class DemandeCreationOrganisation{
    descriptionCrO : str
    dateDemandeCrO : date
    statutCrO : enum {validee, refusee, en_attente}
}
class DemandeChangerOrganisation{
    descriptionChO : str
    dateDemandeChO : date
    statutChO : enum {validee, refusee, en_attente}
}



Candidat "*" -- "*" Offre_Emploi : > postule à
(Candidat, Offre_Emploi) .. Candidature
Offre_Emploi "1..*" --* "1" Fiche_Poste : > est rattachée à
Organisation *-- Fiche_Poste : > propose
Candidature "1" *-- "1..*" Piece_Jointe_Temporaire : > contient
Recruteur "1..*" -- "0..1" Organisation : > est dans
Candidat *-- Piece_Jointe_Durable : > possède

DemandeCreationOrganisation "*" -- "1" Candidat : < veut créer une organisation
Organisation "1" -- "*" DemandeCreationOrganisation : < demande relative à 
DemandeRecruteur "*" -- "1" Candidat : < veut devenir recruteur
Organisation "1" -- "*" DemandeRecruteur : < demande pour

Recruteur "1" *-- "*" DemandeChangerOrganisation : > veut changer d'organisation
DemandeChangerOrganisation "*" -- "1" Organisation : > demande concernant 

'Héritage
Candidat --|> Utilisateur 
Recruteur --|> Utilisateur
Administrateur --|> Utilisateur

note left of Recruteur
un recruteur ne peut pas candidater
end note

note right of DemandeCreationOrganisation
le candidat devient automatiquement recruteur de son organisation
end note

note bottom of DemandeRecruteur
si le candidat devient recruteur, il rejoint l'organisation
end note

note bottom of Offre_Emploi
numero UNIQUE
end note

note right of Organisation
numero siren UNIQUE
end note

note as Note1
- Par défaut les relations composées représentent une cardinalité de 1:N,
sinon on précise leurs cardinalités
- Les offres crées n'ont pas besoin d'être liées au recruteur qui les publié.
- Lors d'une candidature toutes les pj durables sont cochées et envoyées 
mais on peut rajouter d'autres documents ou modifier certaines pièces 
en joignant d'autres pj temporaires à la place.
end note

@enduml