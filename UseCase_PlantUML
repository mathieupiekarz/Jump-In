@startuml

actor Candidat
actor Recruteur
actor Administrateur

Administrateur -up-|> Recruteur
Recruteur -up-|> Candidat

rectangle "Application web de recrutement" {
    (Creer un compte) as UC0
    (Authentification) as UC1
    (Recherche et lister des offres) as UC2
    (Trier les offres) as UC3
    (Consulter une offre) as UC4
    (Consulter son profil candidat) as UC5
    (Partager ses fichiers en tant que candidat) as UC6
    (Candidater à une offre) as UC7
    (Rejoindre une organisation) as UC8
    (Publier une offre) as UC9
    (Afficher la liste des offres de son organisation) as UC17
    (Afficher une offre en détail et la liste des candidats à cette offre) as UC10
    (Consulter un candidat à une offre) as UC11
    (Télécharger les fichiers d'un candidat) as UC12
    (Supprimer une offre) as UC13
    (Modifier une offre) as UC14
    (Ajout d'une organisation) as UC15
    (Donner les droits d'administrations à quelqu'un) as UC16
    
    UC0 ..> UC1 : <<extend>>
    UC2 ..> UC1 : <<include>>
    UC3 ..> UC2 : <<extend>>
    UC4 ..> UC2 : <<extend>>
    UC5 ..> UC1 : <<include>>
    UC5 <.. UC6 : <<extend>>
    UC7 ..> UC1 : <<incude>>
    UC8 ..> UC1 : <<incude>>
    UC17 <.. UC10 : <<extend>>
    UC10 <.. UC11 : <<extend>>
    
    Candidat --> UC1
    Candidat --> UC2
    Candidat --> UC5
    Candidat --> UC7
    Candidat --> UC8
    Recruteur --> UC9
    Recruteur --> UC12
    Recruteur --> UC17
    Recruteur --> UC13
    Recruteur --> UC14
    Candidat --> UC15
    Administrateur --> UC8
    Administrateur --> UC15
    Administrateur --> UC16
    
    
    
}
@enduml